---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const normalizeEntries = (entries: any[], prefix: string) =>
  entries.map(entry => {
    const urlSlug = entry.data.slug ?? entry.id;
    return {
      href: `/articles/${prefix}/${urlSlug}`,
      slug: urlSlug,
      title: entry.data.title,
      description: entry.data.description,
      date: entry.data.pubDate ?? '',
      image: entry.data.image ?? '',
      category: entry.data.category ?? '',
    };
  });

const [agaEntries, edEntries, mensHealthEntries, clinicEntries] = await Promise.all([
  getCollection('aga'),
  getCollection('ed'),
  getCollection('mens-health'),
  getCollection('clinic'),
]);

const edArticles     = normalizeEntries(edEntries, 'ed').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const agaArticles    = normalizeEntries(agaEntries, 'aga').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const clinicArticles = normalizeEntries(clinicEntries, 'clinic').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const mensArticles   = normalizeEntries(mensHealthEntries, 'mens-health').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categoryGroups = [
  { key: 'ed',          label: 'ED治療薬ガイド',  emoji: '💊', href: '/articles/ed',          articles: edArticles },
  { key: 'aga',         label: 'AGA治療薬ガイド', emoji: '💇', href: '/articles/aga',         articles: agaArticles },
  { key: 'clinic',      label: 'クリニック比較',   emoji: '🏥', href: '/articles/clinic',      articles: clinicArticles },
  { key: 'mens-health', label: '男性の悩み',       emoji: '💪', href: '/articles/mens-health', articles: mensArticles },
];
---

<Layout title="男の処方箋〜AGA・EDを薬剤師が全部答えてみた〜" description="調剤薬局長として18年のキャリアを持つ現役薬剤師がED・AGA治療薬・オンラインクリニックを本音で比較・解説します。">
  <main class="container page-wrapper py-6">

    <!-- ① ヒーローエリア -->
    <section class="mb-12 px-2">
      <div class="hero-image-wrapper mb-6">
        <img
          src="/hero.webp"
          alt="男の処方箋 クリニックに忖度しない薬剤師が本音で解説"
          class="w-full rounded-2xl object-cover"
          loading="eager"
        />
      </div>
      <h1 class="text-base font-black text-slate-800 text-center leading-snug mb-7">
        クリニックに忖度しない薬剤師が本音で解説
      </h1>
      <div class="grid grid-cols-2 gap-3">
        <a href="#ed-section" class="hero-icon-btn hero-icon-btn--ed">
          <svg viewBox="0 0 32 32" width="36" height="36" fill="none" aria-hidden="true">
            <path d="M16 4C10.477 4 6 8.477 6 14s4.477 10 10 10c1.647 0 3.2-.398 4.567-1.1A8 8 0 0 1 16 4z" stroke="#0ea5e9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <rect x="18" y="22" width="10" height="5" rx="2.5" stroke="#0ea5e9" stroke-width="1.8"/>
            <line x1="23" y1="22" x2="23" y2="27" stroke="#0ea5e9" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <span class="hero-icon-btn__label">夜の悩み・ED治療</span>
          <span class="hero-icon-btn__sub">治療薬を比較する →</span>
        </a>
        <a href="#aga-section" class="hero-icon-btn hero-icon-btn--aga">
          <svg viewBox="0 0 32 32" width="36" height="36" fill="none" aria-hidden="true">
            <circle cx="16" cy="21" r="8" stroke="#10b981" stroke-width="1.8"/>
            <path d="M10 16C10 10 22 10 22 16" stroke="#10b981" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M13 13C13 9 19 9 19 13" stroke="#10b981" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="hero-icon-btn__label">AGA・薄毛の悩み</span>
          <span class="hero-icon-btn__sub">治療薬を比較する →</span>
        </a>
      </div>
    </section>

    <!-- ② 信頼バッジ -->
    <section class="mb-12 px-2">
      <div class="grid grid-cols-3 gap-2">
        <!-- バッジ①：クリニックに忖度しない -->
        <div class="trust-badge">
          <svg viewBox="0 0 32 32" width="34" height="34" fill="none" stroke="#0ea5e9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 3L5 8v7c0 5.5 4.7 10.7 11 12.5C23.3 25.7 27 20.5 27 15V8L16 3z"/>
            <line x1="12" y1="13" x2="20" y2="21"/>
            <line x1="20" y1="13" x2="12" y2="21"/>
          </svg>
          <span class="trust-badge__label">クリニックに<br/>忖度しない</span>
        </div>
        <!-- バッジ②：添付文書・論文ベース -->
        <div class="trust-badge">
          <svg viewBox="0 0 32 32" width="34" height="34" fill="none" stroke="#0ea5e9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 4h13l5 5v19H6V4z"/>
            <polyline points="19 4 19 9 24 9"/>
            <line x1="10" y1="14" x2="20" y2="14"/>
            <line x1="10" y1="18" x2="16" y2="18"/>
            <circle cx="23" cy="24" r="4"/>
            <line x1="26" y1="27" x2="29" y2="30"/>
          </svg>
          <span class="trust-badge__label">添付文書・<br/>論文ベース</span>
        </div>
        <!-- バッジ③：現役薬剤師が本音解説 -->
        <div class="trust-badge">
          <svg viewBox="0 0 32 32" width="34" height="34" fill="none" stroke="#0ea5e9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="10" r="4"/>
            <path d="M4 28c0-4 3.1-7 7-7s7 3 7 7"/>
            <path d="M19 7h9a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-1l-2 3-2-3h-4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z"/>
          </svg>
          <span class="trust-badge__label">現役薬剤師が<br/>本音解説</span>
        </div>
      </div>
    </section>

    <!-- ③ クリニック比較バナー -->
    <section class="mb-12 px-2">
      <a href="/articles/clinic/online-clinic-comparison" class="clinic-banner">
        <div>
          <p class="text-sm font-black text-white leading-snug mb-1">
            💉 ED・AGAどちらもオンラインクリニックが最安・最速
          </p>
          <p class="text-[11px] text-sky-200 font-bold leading-snug">
            DMM・レバクリ・クリニックフォアを薬剤師が徹底比較
          </p>
        </div>
        <span class="clinic-banner-btn">比較記事を読む →</span>
      </a>
    </section>

    <!-- ④ カテゴリ別記事グリッド -->
    {categoryGroups.map(group => group.articles.length > 0 && (
      <section id={group.key === 'ed' ? 'ed-section' : group.key === 'aga' ? 'aga-section' : undefined} class="mb-14 px-2">
        <!-- セクションヘッダー -->
        <div class="flex justify-between items-center mb-1">
          <h2 class="text-base font-black text-slate-800 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-sky-500 rounded-full flex-shrink-0"></span>
            {group.emoji} {group.label}
          </h2>
          <a href={group.href} class="category-list-btn">
            <span>記事一覧をみる</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </a>
        </div>
        <!-- カードグリッド（最新4件） -->
        <div class="articles-grid">
          {group.articles.slice(0, 4).map(article => (
            <a href={article.href} class="article-card">
              <div class="article-card-image">
                {article.image
                  ? <img src={article.image} alt={article.title} loading="lazy" />
                  : <div class="article-card-image-placeholder"></div>
                }
              </div>
              <div class="article-card-body">
                {article.category && (
                  <span class="article-category-badge">{article.category}</span>
                )}
                <h3 class="article-card-title">{article.title}</h3>
                <p class="article-card-desc">{article.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- ⑤ 運営者紹介 -->
    <section class="mb-4 px-2">
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5">
        <p class="text-sm text-slate-600 font-medium leading-relaxed mb-3">
          調剤薬局長として18年、ED・AGA処方箋を日常的に扱う現役薬剤師が運営しています。
        </p>
        <a href="/about" class="text-sm font-bold text-sky-600 hover:underline">
          運営者詳細を見る →
        </a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .page-wrapper {
    max-width: 480px;
    margin: 0 auto;
  }

  /* Hero */
  .hero-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1rem;
    background: #f8fafc;
  }
  .hero-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hero icon buttons */
  .hero-icon-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1.1rem 0.75rem;
    border-radius: 1rem;
    background: #ffffff;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: background 0.2s, transform 0.15s;
    text-align: center;
  }
  .hero-icon-btn:active { transform: scale(0.97); }

  .hero-icon-btn--ed  { border: 2px solid #38bdf8; }
  .hero-icon-btn--ed:hover  { background: #f0f9ff; }
  .hero-icon-btn--aga { border: 2px solid #34d399; }
  .hero-icon-btn--aga:hover { background: #f0fdf4; }

  .hero-icon-btn__label {
    font-size: 0.78rem;
    font-weight: 900;
    color: #1e293b;
    line-height: 1.3;
  }
  .hero-icon-btn__sub {
    font-size: 0.65rem;
    font-weight: 700;
    color: #64748b;
    line-height: 1.2;
  }

  /* Trust badges */
  .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.85rem 0.5rem;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 0.875rem;
    text-align: center;
  }
  .trust-badge__label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #334155;
    line-height: 1.4;
  }

  /* Clinic banner */
  .clinic-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #0f2d5a 0%, #1a4280 60%, #0e7490 100%);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .clinic-banner:hover { opacity: 0.92; }
  .clinic-banner-btn {
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 800;
    color: #0f2d5a;
    background: #fff;
    padding: 0.4rem 0.75rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  /* Category section list button */
  .category-list-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #0369a1;
    background: #f0f9ff;
    border: 1.5px solid #7dd3fc;
    border-radius: 9999px;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .category-list-btn:hover { background: #e0f2fe; }

  /* Article card grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 0.6rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.07);
    border-color: #e0f2fe;
  }

  .article-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
    background: #f8fafc;
  }
  .article-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0f2fe, #f0f9ff);
  }

  .article-card-body {
    flex: 1;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .article-category-badge {
    font-size: 0.6rem;
    font-weight: 800;
    color: #0369a1;
    background: #f0f9ff;
    padding: 2px 6px;
    border-radius: 9999px;
    align-self: flex-start;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .article-card-title {
    font-size: 0.72rem;
    font-weight: 900;
    color: #1e293b;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .article-card-desc {
    font-size: 0.62rem;
    color: #64748b;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
</style>
