---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const normalizeEntries = (entries: any[], prefix: string) =>
  entries.map(entry => {
    const urlSlug = entry.data.slug ?? entry.id;
    return {
      href: `/articles/${prefix}/${urlSlug}`,
      slug: urlSlug,
      title: entry.data.title,
      description: entry.data.description,
      date: entry.data.pubDate ?? '',
      image: entry.data.image ?? '',
      category: entry.data.category ?? '',
    };
  });

const [agaEntries, edEntries, mensHealthEntries, clinicEntries] = await Promise.all([
  getCollection('aga'),
  getCollection('ed'),
  getCollection('mens-health'),
  getCollection('clinic'),
]);

const articles = [
  ...normalizeEntries(agaEntries, 'aga'),
  ...normalizeEntries(edEntries, 'ed'),
  ...normalizeEntries(mensHealthEntries, 'mens-health'),
  ...normalizeEntries(clinicEntries, 'clinic'),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="男の処方箋" description="男性の健康・薬・セルフケアについて、薬の知識をわかりやすく解説するサイトです。">
  <main class="container page-wrapper py-8">

    <!-- Hero -->
    <section class="text-center mb-10 px-4">
      <h1 class="text-2xl font-black text-slate-800 leading-tight mb-3">
        男の処方箋
      </h1>
      <p class="text-sm text-slate-500 font-bold leading-relaxed">
        男性の健康・薬・セルフケアを、薬の専門知識でわかりやすく解説します。
      </p>
    </section>

    <!-- カテゴリナビ -->
    <section class="mb-8 px-2">
      <div class="grid grid-cols-3 gap-2">
        {[
          { href: '/articles/aga',         label: 'AGA（薄毛・育毛）', emoji: '💇' },
          { href: '/articles/ed',          label: 'ED（勃起不全）',   emoji: '💊' },
          { href: '/articles/mens-health', label: '男性の悩み',        emoji: '💪' },
          { href: '/articles/clinic',      label: 'クリニック比較',    emoji: '🏥' },
          { href: '/about',                label: '運営者情報',        emoji: '👤' },
        ].map(({ href, label, emoji }) => (
          <a
            href={href}
            class="flex flex-col items-center gap-1 p-3 bg-white border border-slate-200 rounded-xl text-center hover:border-sky-300 hover:bg-sky-50 transition-colors"
          >
            <span class="text-xl">{emoji}</span>
            <span class="text-xs font-bold text-slate-700">{label}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- 最新記事 -->
    {articles.length > 0 ? (
      <section class="mb-8">
        <h2 class="text-base font-black text-slate-800 px-2 mb-4 flex items-center gap-2">
          <span class="text-sky-500">📋</span> 最新記事
        </h2>
        <div class="flex flex-col gap-4">
          {articles.map(article => (
            <a
              href={article.href}
              class="flex gap-3 p-3 bg-white border border-slate-200 rounded-xl hover:border-sky-300 hover:bg-sky-50 transition-colors"
            >
              {article.image && (
                <img
                  src={article.image}
                  alt={article.title}
                  class="w-20 h-16 object-cover rounded-lg flex-shrink-0"
                  loading="lazy"
                />
              )}
              <div class="flex flex-col justify-center min-w-0">
                {article.category && (
                  <span class="text-[10px] font-bold text-sky-600 mb-1">{article.category}</span>
                )}
                <p class="text-sm font-black text-slate-800 leading-snug line-clamp-2">{article.title}</p>
                {article.date && (
                  <span class="text-[10px] text-slate-400 mt-1">{article.date}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      </section>
    ) : (
      <section class="mb-8 px-4 text-center">
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8">
          <p class="text-slate-500 font-bold text-sm">記事を準備中です。しばらくお待ちください。</p>
        </div>
      </section>
    )}

  </main>
</Layout>
