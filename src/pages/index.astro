---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const normalizeEntries = (entries: any[], prefix: string) =>
  entries.map(entry => {
    const urlSlug = entry.data.slug ?? entry.id;
    return {
      href: `/articles/${prefix}/${urlSlug}`,
      slug: urlSlug,
      title: entry.data.title,
      description: entry.data.description,
      date: entry.data.pubDate ?? '',
      image: entry.data.image ?? '',
      category: entry.data.category ?? '',
    };
  });

const [agaEntries, edEntries, mensHealthEntries, clinicEntries] = await Promise.all([
  getCollection('aga'),
  getCollection('ed'),
  getCollection('mens-health'),
  getCollection('clinic'),
]);

const edArticles     = normalizeEntries(edEntries, 'ed').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const agaArticles    = normalizeEntries(agaEntries, 'aga').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const clinicArticles = normalizeEntries(clinicEntries, 'clinic').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
const mensArticles   = normalizeEntries(mensHealthEntries, 'mens-health').sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const categoryGroups = [
  { key: 'ed',          label: 'ED治療薬ガイド',  href: '/articles/ed',          articles: edArticles },
  { key: 'aga',         label: 'AGA治療薬ガイド', href: '/articles/aga',         articles: agaArticles },
  { key: 'clinic',      label: 'クリニック比較',   href: '/articles/clinic',      articles: clinicArticles },
  { key: 'mens-health', label: '男性の悩み',       href: '/articles/mens-health', articles: mensArticles },
];
---

<Layout title="男の処方箋〜AGA・EDを薬剤師が全部答えてみた〜" description="調剤薬局長として18年のキャリアを持つ現役薬剤師がED・AGA治療薬・オンラインクリニックを本音で比較・解説します。">
  <main class="container page-wrapper py-8">

    <!-- ① ヒーローエリア -->
    <section class="mb-16 px-2">
      <div class="hero-image-wrapper mb-8">
        <img
          src="/hero.webp"
          alt="男の処方箋 クリニックに忖度しない薬剤師が本音で解説"
          class="w-full rounded-2xl object-cover"
          loading="eager"
        />
      </div>
      <h1 class="text-base font-black text-slate-700 text-center leading-snug mb-3">
        クリニックに忖度しない薬剤師が本音で解説
      </h1>
      <div class="flex justify-center mb-8">
        <span class="text-sm font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 rounded-full px-4 py-1.5">
          ↓ あなたの悩みを選んでください ↓
        </span>
      </div>
      <div class="grid grid-cols-2 gap-5">

        <!-- EDボタン：sky-500ボーダー、三日月＋錠剤SVG -->
        <a href="#ed-section" class="hero-icon-btn hero-icon-btn--ed">
          <svg viewBox="0 0 32 32" width="48" height="48" fill="none" aria-hidden="true">
            <!-- 三日月を45度傾けて斜め向きに -->
            <g transform="rotate(-45, 16, 16)">
              <path d="M17 4C10 4 4 9 4 16C4 23 10 28 17 28C13 25.5 11 22 11 16C11 10 13 6.5 17 4z"
                stroke="#0ea5e9" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </g>
          </svg>
          <span class="hero-icon-btn__label">夜の悩み・ED治療</span>
        </a>

        <!-- AGAボタン：blue-600ボーダー、M字ハゲSVG -->
        <a href="#aga-section" class="hero-icon-btn hero-icon-btn--aga">
          <svg viewBox="0 0 32 32" width="48" height="48" fill="none" aria-hidden="true">
            <!-- 頭部の丸いアウトライン -->
            <circle cx="16" cy="18" r="11" stroke="#2563eb" stroke-width="1.5"/>
            <!-- M字の生え際：両サイドが残り、中央が凹む -->
            <path d="M8 15 C9 10 12 9 13 10 L16 13 L19 10 C20 9 23 10 24 15"
              stroke="#2563eb" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="hero-icon-btn__label">AGA・薄毛の悩み</span>
        </a>

      </div>
    </section>

    <!-- ② 信頼バッジ -->
    <section class="mb-16 px-2">
      <div class="grid grid-cols-3 gap-3">

        <!-- 盾＋× -->
        <div class="trust-badge">
          <svg viewBox="0 0 28 28" width="30" height="30" fill="none" stroke="#0284c7" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2L3 7v6c0 5.5 4.5 10 11 12 6.5-1.5 11-6.5 11-12V7L14 2z"/>
            <line x1="10" y1="11" x2="18" y2="19"/>
            <line x1="18" y1="11" x2="10" y2="19"/>
          </svg>
          <span class="trust-badge__label">クリニックに<br/>忖度しない</span>
        </div>

        <!-- 書類ライン -->
        <div class="trust-badge">
          <svg viewBox="0 0 28 28" width="30" height="30" fill="none" stroke="#0284c7" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2h11l5 5v19H6V2z"/>
            <polyline points="17 2 17 7 22 7"/>
            <line x1="9" y1="13" x2="19" y2="13"/>
            <line x1="9" y1="17" x2="15" y2="17"/>
            <line x1="9" y1="21" x2="17" y2="21"/>
          </svg>
          <span class="trust-badge__label">添付文書・<br/>論文ベース</span>
        </div>

        <!-- 吹き出しライン -->
        <div class="trust-badge">
          <svg viewBox="0 0 28 28" width="30" height="30" fill="none" stroke="#0284c7" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 3h22a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-6 6v-6H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/>
          </svg>
          <span class="trust-badge__label">現役薬剤師が<br/>本音解説</span>
        </div>

      </div>
    </section>

    <!-- ③ クリニック比較バナー（2分割） -->
    <section class="mb-16 px-2">
      <div class="grid grid-cols-2 gap-3">
        <a href="/articles/ed/ed-clinic-comparison" class="clinic-card">
          <p class="clinic-card__title">ED治療<br/>クリニック比較</p>
          <p class="clinic-card__sub">DMM・レバクリ・クリニックフォア</p>
          <span class="clinic-card__btn">比較を見る →</span>
        </a>
        <a href="/articles/aga/aga-clinic-comparison" class="clinic-card">
          <p class="clinic-card__title">AGA治療<br/>クリニック比較</p>
          <p class="clinic-card__sub">DMM・レバクリ・クリニックフォア</p>
          <span class="clinic-card__btn">比較を見る →</span>
        </a>
      </div>
    </section>

    <!-- ④ カテゴリ別記事グリッド -->
    {categoryGroups.map(group => group.articles.length > 0 && (
      <section id={group.key === 'ed' ? 'ed-section' : group.key === 'aga' ? 'aga-section' : undefined} class="mb-20 px-2">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-base font-black text-slate-800 flex items-center gap-2">
            <span class="w-1.5 h-5 bg-sky-500 rounded-full flex-shrink-0"></span>
            {group.label}
          </h2>
          <a href={group.href} class="category-list-btn">
            <span>記事一覧をみる</span>
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
          </a>
        </div>
        <div class="articles-grid">
          {group.articles.slice(0, 4).map(article => (
            <a href={article.href} class="article-card">
              <div class="article-card-image">
                {article.image
                  ? <img src={article.image} alt={article.title} loading="lazy" />
                  : <div class="article-card-image-placeholder"></div>
                }
              </div>
              <div class="article-card-body">
                {article.category && (
                  <span class="article-category-badge">{article.category}</span>
                )}
                <h3 class="article-card-title">{article.title}</h3>
                <p class="article-card-desc">{article.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <!-- ⑤ 運営者紹介 -->
    <section class="mb-8 px-2">
      <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6">
        <p class="text-sm text-slate-600 font-medium leading-relaxed mb-4">
          調剤薬局長として18年、ED・AGA処方箋を日常的に扱う現役薬剤師が運営しています。
        </p>
        <a href="/about" class="text-sm font-bold text-sky-600 hover:underline">
          運営者詳細を見る →
        </a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .page-wrapper {
    max-width: 480px;
    margin: 0 auto;
  }

  /* Hero */
  .hero-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 1rem;
    background: #f8fafc;
  }
  .hero-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Hero icon buttons */
  .hero-icon-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.5rem 0.75rem;
    border-radius: 1rem;
    background: #ffffff;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    transition: background 0.2s, transform 0.15s;
    text-align: center;
  }
  .hero-icon-btn:active { transform: scale(0.97); }

  .hero-icon-btn--ed  { border: 2px solid #0ea5e9; }
  .hero-icon-btn--ed:hover  { background: #f0f9ff; }
  .hero-icon-btn--aga { border: 2px solid #2563eb; }
  .hero-icon-btn--aga:hover { background: #eff6ff; }

  .hero-icon-btn__label {
    font-size: 0.78rem;
    font-weight: 900;
    color: #1e293b;
    line-height: 1.3;
  }

  /* Trust badges */
  .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.1rem 0.5rem;
    background: #f0f9ff;
    border: 1px solid #bae6fd;
    border-radius: 0.875rem;
    text-align: center;
  }
  .trust-badge__label {
    font-size: 0.65rem;
    font-weight: 700;
    color: #334155;
    line-height: 1.4;
  }

  /* Clinic cards (2-panel) */
  .clinic-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 1.5rem 1.1rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #0f2d5a 0%, #1a4280 60%, #0e7490 100%);
    text-decoration: none;
    transition: opacity 0.2s;
  }
  .clinic-card:hover { opacity: 0.92; }
  .clinic-card__title {
    font-size: 0.95rem;
    font-weight: 900;
    color: #ffffff;
    line-height: 1.45;
  }
  .clinic-card__sub {
    font-size: 0.6rem;
    font-weight: 700;
    color: #bae6fd;
    line-height: 1.4;
  }
  .clinic-card__btn {
    margin-top: 0.4rem;
    font-size: 0.68rem;
    font-weight: 800;
    color: #0f2d5a;
    background: #ffffff;
    padding: 0.35rem 0.8rem;
    border-radius: 9999px;
    white-space: nowrap;
  }

  /* Category section list button */
  .category-list-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: #0369a1;
    background: #f0f9ff;
    border: 1.5px solid #7dd3fc;
    border-radius: 9999px;
    padding: 0.3rem 0.75rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .category-list-btn:hover { background: #e0f2fe; }

  /* Article card grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 1rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.07);
    border-color: #e0f2fe;
  }

  .article-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
    background: #f8fafc;
  }
  .article-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0f2fe, #f0f9ff);
  }

  .article-card-body {
    flex: 1;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .article-category-badge {
    font-size: 0.6rem;
    font-weight: 800;
    color: #0369a1;
    background: #f0f9ff;
    padding: 2px 6px;
    border-radius: 9999px;
    align-self: flex-start;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .article-card-title {
    font-size: 0.72rem;
    font-weight: 900;
    color: #1e293b;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .article-card-desc {
    font-size: 0.62rem;
    color: #64748b;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }
</style>
