---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const normalizeEntries = (entries: any[], prefix: string) =>
  entries.map(entry => {
    const urlSlug = entry.data.slug ?? entry.id;
    return {
      href: `/articles/${prefix}/${urlSlug}`,
      title: entry.data.title,
      description: entry.data.description,
      date: entry.data.pubDate ?? '',
      image: entry.data.image ?? '',
      category: entry.data.category ?? '',
    };
  });

const [agaEntries, edEntries, mensHealthEntries, clinicEntries] = await Promise.all([
  getCollection('aga'),
  getCollection('ed'),
  getCollection('mens-health'),
  getCollection('clinic'),
]);

const articles = [
  ...normalizeEntries(agaEntries, 'aga'),
  ...normalizeEntries(edEntries, 'ed'),
  ...normalizeEntries(mensHealthEntries, 'mens-health'),
  ...normalizeEntries(clinicEntries, 'clinic'),
].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="記事一覧 | 男の処方箋">
  <div class="container page-wrapper py-8 animate-fade-in">
    <main>
      <header class="mb-8 px-2">
        <a href="/" class="text-sm font-bold text-sky-600 hover:underline mb-4 inline-block">← トップページに戻る</a>
        <h1 class="text-xl font-black text-slate-800">記事一覧</h1>
      </header>

      {articles.length > 0 ? (
        <div class="flex flex-col gap-4 px-2">
          {articles.map(article => (
            <a
              href={article.href}
              class="flex gap-3 p-3 bg-white border border-slate-200 rounded-xl hover:border-sky-300 hover:bg-sky-50 transition-colors"
            >
              {article.image && (
                <img
                  src={article.image}
                  alt={article.title}
                  class="w-20 h-16 object-cover rounded-lg flex-shrink-0"
                  loading="lazy"
                />
              )}
              <div class="flex flex-col justify-center min-w-0">
                {article.category && (
                  <span class="text-[10px] font-bold text-sky-600 mb-1">{article.category}</span>
                )}
                <p class="text-sm font-black text-slate-800 leading-snug line-clamp-2">{article.title}</p>
                {article.date && (
                  <span class="text-[10px] text-slate-400 mt-1">{article.date}</span>
                )}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="px-2 text-center">
          <div class="bg-slate-50 border border-slate-200 rounded-2xl p-8">
            <p class="text-slate-500 font-bold text-sm">記事を準備中です。しばらくお待ちください。</p>
          </div>
        </div>
      )}
    </main>
  </div>
</Layout>
