---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('ed');
const articles = entries
  .map(entry => {
    const urlSlug = entry.data.slug ?? entry.id;
    return {
      href: `/articles/ed/${urlSlug}`,
      title: entry.data.title,
      description: entry.data.description,
      date: entry.data.pubDate ?? '',
      image: entry.data.image ?? '',
      category: entry.data.category ?? '',
    };
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title="ED治療薬ガイド | 男の処方箋" description="ED治療薬・オンラインクリニックを薬剤師が本音で解説。バイアグラ・シアリス・バルデナフィルの比較から選び方まで。">
  <div class="container page-wrapper py-8 animate-fade-in">
    <main>
      <header class="mb-6 px-2">
        <a href="/" class="back-link">← トップページに戻る</a>
        <h1 class="page-title">ED治療薬ガイド</h1>
        <p class="page-desc">薬剤師18年のキャリアが本音で解説</p>
      </header>

      {articles.length > 0 ? (
        <div class="articles-grid px-2">
          {articles.map(article => (
            <a href={article.href} class="article-card">
              <div class="article-card-image">
                {article.image
                  ? <img src={article.image} alt={article.title} loading="lazy" />
                  : <div class="article-card-image-placeholder"></div>
                }
              </div>
              <div class="article-card-body">
                {article.category && (
                  <span class="article-category-badge">{article.category}</span>
                )}
                <h3 class="article-card-title">{article.title}</h3>
                <p class="article-card-desc">{article.description}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="px-2 text-center">
          <div class="empty-state">
            <p>記事を準備中です。しばらくお待ちください。</p>
          </div>
        </div>
      )}
    </main>
  </div>
</Layout>

<style>
  .page-wrapper {
    max-width: 480px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #0369a1;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .back-link:hover { text-decoration: underline; }

  .page-title {
    font-size: 1.25rem;
    font-weight: 900;
    color: #1e293b;
    margin-bottom: 0.25rem;
  }

  .page-desc {
    font-size: 0.78rem;
    color: #64748b;
    font-weight: 500;
    margin-bottom: 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 14px;
    border: 1px solid #f1f5f9;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.07);
    border-color: #e0f2fe;
  }

  .article-card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
    background: #f8fafc;
  }
  .article-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card-image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0f2fe, #f0f9ff);
  }

  .article-card-body {
    flex: 1;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .article-category-badge {
    font-size: 0.6rem;
    font-weight: 800;
    color: #0369a1;
    background: #f0f9ff;
    padding: 2px 6px;
    border-radius: 9999px;
    align-self: flex-start;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .article-card-title {
    font-size: 0.72rem;
    font-weight: 900;
    color: #1e293b;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .article-card-desc {
    font-size: 0.62rem;
    color: #64748b;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .empty-state {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 2rem;
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 700;
  }
</style>
